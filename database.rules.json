{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid",
        "guest": { ".write": "auth != null && data.val() === '' && newData.val() === auth.uid" },
        "round": { ".write": "auth != null && data.parent.child('host').val() === auth.uid && newData.val() === data.val() + 1" },
        "moves": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (data.parent.parent.parent.child('host').val() === auth.uid || data.parent.parent.parent.child('guest').val() === auth.uid)",
              ".validate": "newData.val() === 'rock' || newData.val() === 'paper' || newData.val() === 'scissors'"
            }
          }
        }
      }
    }
  }
}
