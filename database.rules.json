{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid",
        "guest": {
          ".write": "auth != null && (data.val() === null || data.val() === '') && newData.val() === auth.uid"
        },
        "round": {
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid && newData.val() === data.val() + 1"
        },
        "moves": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (root.child('rooms').child($room).child('host').val() === auth.uid || root.child('rooms').child($room).child('guest').val() === auth.uid)",
              ".validate": "newData.val() === 'rock' || newData.val() === 'paper' || newData.val() === 'scissors'"
            }
          }
        }
      }
    }
  }
}
